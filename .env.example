# ==========================================
# Guía rápida para obtener tus claves en 3 minutos:
# 1. Ve a https://console.firebase.google.com
# 2. Crea un proyecto (ej. "jjtech-medellin").
# 3. En la barra lateral activa:
#    - "Firestore Database" (modo de prueba / reglas públicas)
#    - "Storage" (almacenamiento de fotos)
# 4. En Configuración del Proyecto (icono de engranaje) -> Tus Apps -> Web (</>):
#    Copia y pega aquí tus valores reemplazando los de abajo:

VITE_FIREBASE_API_KEY=AIzaSyTuClaveDeApiRealAqui123456789
VITE_FIREBASE_AUTH_DOMAIN=jjtech-medellin.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jjtech-medellin
VITE_FIREBASE_STORAGE_BUCKET=jjtech-medellin.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=89234823901
VITE_FIREBASE_APP_ID=1:89234823901:web:98ab76cd54ef3210
